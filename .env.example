LITELLM_MASTER_KEY=sk-your-master-key
CLAUDE_OAUTH_TOKEN=sk-ant-oat01-your-claude-oauth-token

# kimi-k2.6 は Hokudai/llens の sglang エンドポイント経由。認証必須。
# pass-through ルート (/sglang) の Authorization ヘッダに差し込まれる。
# 未設定/空でも litellm は起動するが、kimi-k2.6 へのリクエストは 401 になる。
KIMI_API_KEY=your-kimi-api-key

# gpt-5.1 系は OpenAI 公式 API 直。未設定/空でも litellm は起動するが、
# gpt-* へのリクエストは 401 になる。
OPENAI_API_KEY=sk-proj-your-openai-api-key

# --- vllm-qwen35 (optional overrides; defaults work for the standard build) ---
MODELS_DIR=./models                                  # host dir mounted to /models
QWEN_MODEL_PATH=/models/qwen35-122b-hybrid-int4fp8   # served checkpoint path

# --- vllm-qwen36 (optional overrides) ---
# 上流公式イメージを使う (ENTRYPOINT が ["vllm","serve"] なので compose の command
# には `serve` を書かない)。詳細: docs/qwen36-vllm.md
VLLM_QWEN36_IMAGE=vllm/vllm-openai:v0.26.0
QWEN36_MODEL_PATH=/models/qwen36-35b-a3b-nvfp4       # nvidia/Qwen3.6-35B-A3B-NVFP4
