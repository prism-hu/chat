# ============================================================================
# prism-gw (唯一の入口 :4000) のキー。**このスタックで唯一クライアントに渡す秘密。**
# これ 1 本で全モデル (Claude / OpenAI / Ollama / vLLM / sglang) に到達できる。
# Nucllei・fugu・外部クライアントはすべてこの値を名乗る。
# ============================================================================
PRISM_GW_API_KEY=sk-your-gateway-key

# LiteLLM は prism-gw の後ろにしか居らずホストにも公開しないので、master key は
# 既定で PRISM_GW_API_KEY を流用する。**別の値にしたいときだけ**設定する。
# LITELLM_MASTER_KEY=sk-your-litellm-master-key
CLAUDE_OAUTH_TOKEN=sk-ant-oat01-your-claude-oauth-token

# kimi-k2.6 は Hokudai/llens の sglang エンドポイント。認証必須。
# **LiteLLM ではなく prism-gw が上流ヘッダに差し込む** (gateway/config.yaml)。
# 未設定/空でも起動はするが、kimi-k2.6 へのリクエストは 401 になる。
KIMI_API_KEY=your-kimi-api-key

# gpt-5.6 系は OpenAI 公式 API 直。未設定/空でも litellm は起動するが、
# gpt-* へのリクエストは 401 になる。
OPENAI_API_KEY=sk-proj-your-openai-api-key

# --- vllm-qwen35 (optional overrides; defaults work for the standard build) ---
MODELS_DIR=./models                                  # host dir mounted to /models
QWEN_MODEL_PATH=/models/qwen35-122b-hybrid-int4fp8   # served checkpoint path

# --- vllm-qwen36 (optional overrides) ---
# 上流公式イメージを使う (ENTRYPOINT が ["vllm","serve"] なので compose の command
# には `serve` を書かない)。詳細: docs/qwen36-vllm.md
VLLM_QWEN36_IMAGE=vllm/vllm-openai:v0.26.0
QWEN36_MODEL_PATH=/models/qwen36-35b-a3b-nvfp4       # nvidia/Qwen3.6-35B-A3B-NVFP4
